      "type": "image-props",
      "x": 60,
      "y": 760,
      "params": { "width": 1024, "height": 1024 },
      "title": "图像属性"
    },
    {
      "id": "n4",
      "type": "clip-text-encoder",
      "x": 460,
      "y": 80,
      "params": {
        "text": "a matte black wireless headphone on a white marble podium, soft studio light, product photography, 85mm lens, high detail",
        "rewrite": false
      },
      "title": "正向编码"
    },
    {
      "id": "n5",
      "type": "clip-text-encoder",
      "x": 460,
      "y": 400,
      "params": {
        "text": "lowres, busy background, text, watermark, distorted product, extra objects",
        "rewrite": false
      },
      "title": "负向编码"
    },
    {
      "id": "n6",
      "type": "empty-latent-image",
      "x": 460,
      "y": 720,
      "params": { "width": 1024, "height": 1024, "batch_size": 1 },
      "title": "空潜空间"
    },
    {
      "id": "n7",
      "type": "ksampler",
      "x": 840,
      "y": 240,
      "params": { "seed": 2026, "steps": 32, "cfg": 6.5, "sampler": "dpmpp_2m", "scheduler": "karras", "denoise": 1 },
      "title": "采样"
    },
    {
      "id": "n8",
      "type": "vae-decode",
      "x": 1180,
      "y": 240,
      "params": {},
      "title": "VAE 解码"
    },
    {
      "id": "n9",
      "type": "image-output",
      "x": 1460,
      "y": 240,
      "params": { "filename": "vcg-product", "format": "png", "open_after": false },
      "title": "图像输出"
    },
    {
      "id": "n10",
      "type": "note",
      "x": 1460,
      "y": 560,
      "params": {
        "text": "产品图示例：检查点同时提供 MODEL / CLIP / VAE，图像属性提供方形尺寸；本地模式需在设置中配置 ComfyUI 服务端，云端模式使用设置中的默认图像模型。"
      },
      "title": "说明"
    }
