      "id": "n1",
      "type": "prompt-input",
      "x": 60,
      "y": 80,
      "params": {
        "positive": "a matte black wireless headphone on a white marble podium, soft studio light, product photography, 85mm lens, high detail",
        "negative": "lowres, busy background, text, watermark, distorted product, extra objects"
      },
      "title": "产品提示词"
    },
    {
      "id": "n2",
      "type": "checkpoint-loader",
      "x": 60,
      "y": 420,
      "params": { "ckpt_name": "sd_xl_base_1.0.safetensors", "model": "" },
      "title": "检查点"
    },
    {
